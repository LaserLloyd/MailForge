# MailForge container settings. Copy to ".env" next to compose.yml, then
#     chmod 0600 deploy/compose/.env
# The real .env is git-ignored and dockerignored: it must never be committed or
# baked into an image. It holds the one secret the container needs.

# --- credential store ---------------------------------------------------------
# Mailbox passwords live in an encrypted file in the data volume
# (keyrings.cryptfile: Argon2 + AES-GCM). This password unlocks it. Choose a
# long random one and keep a copy in your password manager: without it the
# stored mailbox credentials cannot be read, and losing it means re-entering
# them with `setup-wizard`.
MAILFORGE_KEYRING_PASSWORD=
# Alternative: point at a file (a Docker secret mounted at /run/secrets/...).
# MAILFORGE_KEYRING_PASSWORD_FILE=/run/secrets/mailforge_keyring

# --- the local LLM server, as seen from inside the container -------------------
# StudioForge / LM Studio on the Docker host. Only the scheme and host:port are
# used (any path is ignored); an https:// URL stays https.
LLM_BASE_URL=http://host.docker.internal:1234/v1

# --- web UI port / exposure ----------------------------------------------------
# 127.0.0.1 = this machine only (the app's design). 0.0.0.0 exposes the UI to
# your network: only do that behind an authenticating reverse proxy.
BIND_ADDR=127.0.0.1
HOST_PORT=8090
# Extra Host header values the UI should accept (comma-separated host or
# host:port, exactly as the browser's address bar shows it), e.g. a reverse-proxy
# name; a TLS proxy on the default port is just the name. localhost:HOST_PORT is
# always added.
# UI_EXTRA_HOSTS=mail.example.lan

# --- any MailForge setting can be overridden here (MAILFORGE_ prefix, __ nesting)
# MAILFORGE_SECURITY__QUARANTINE_THRESHOLD=0.9

# --- storage / limits ---------------------------------------------------------
# DATA_PATH=/srv/mailforge     # host dir (owned by UID 1000) instead of the named volume
# EXTRAS="llm rag"             # build-time: add "security-ml" for the heavy guardrails
TZ=UTC
MEM_LIMIT=1g
CPU_LIMIT=2.0
