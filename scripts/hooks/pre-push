#!/bin/sh
# Last gate before anything leaves the machine.
#
# A push publishes two different things, and the working tree is neither:
#   (a) the TREE of every commit being pushed (git ls-tree, not the checkout —
#       the working copy can be clean while the travelling commit is not);
#   (b) the MESSAGE of every outgoing commit.
#
# git feeds us "<local ref> <local sha> <remote ref> <remote sha>" on stdin.
set -e
cd "$(git rev-parse --show-toplevel)"

remote_name="$1"

# The all-zero sha means "no such ref"; its LENGTH differs between sha1 and
# sha256 repos, so test the digits rather than comparing to 40 zeros.
is_zero() {
    case "$1" in
        '' | *[!0]*) return 1 ;;
        *)           return 0 ;;
    esac
}

if git remote get-url "$remote_name" >/dev/null 2>&1; then
    not_remotes="--not --remotes=$remote_name"
else
    not_remotes="--not --remotes"
fi

status=0
saw_ref=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "$local_sha" ] || continue
    if is_zero "$local_sha"; then continue; fi   # deleting a ref publishes nothing
    saw_ref=1

    python3 scripts/scrub_check.py --rev "$local_sha" || status=1

    if is_zero "$remote_sha"; then
        range="$local_sha $not_remotes"
    elif ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null \
         || ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
        # Force push, or a remote whose history is unrelated to ours. The
        # range would be invalid, git log would fail, and a failed scan must
        # never read as a clean one — scan everything the remote lacks.
        echo "pre-push: remote tip $remote_sha is not an ancestor; scanning all outgoing commits"
        range="$local_sha $not_remotes"
    else
        range="$remote_sha..$local_sha"
    fi
    python3 scripts/scrub_check.py --commit-range "$range" || status=1
done

if [ "$saw_ref" = 0 ]; then
    echo "pre-push: nothing to scan (no refs being created or updated)"
fi

if [ "$status" != 0 ]; then
    echo "" >&2
    echo "pre-push: REFUSING to publish. Fix the commits above, then push again." >&2
    echo "          (History is already written: an amend or rebase is the fix," >&2
    echo "           not a new commit on top — the old one still carries it.)" >&2
fi
exit $status
